# ============ GATEWAY WHATSAPP (Fonnte) ============
# Token dari dashboard fonnte.com
FONNTE_TOKEN=your_fonnte_token
FONNTE_FROM_NUMBER=6281227928537

# ============ LLM (Groq) ============
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ============ WEBHOOK SECURITY ============
# Jika diisi, webhook /webhook/fonnte hanya menerima token ini.
# Kirim via header "x-webhook-token" ATAU tambahkan "?token=<isi>" pada URL webhook Fonnte.
WEBHOOK_SECRET=

# ============ AUTH API (/api/v1/*) ============
# Auth aktif jika JWT_SECRET_KEY ATAU API_TOKEN diisi. Kosong semua => dev mode (terbuka).
JWT_SECRET_KEY=
JWT_EXPIRATION=86400
API_TOKEN=
ADMIN_USER=admin
ADMIN_PASSWORD=

# ============ CORS ============
# Daftar origin yang diizinkan (pisahkan dengan koma). Kosong => default localhost dev.
CORS_ORIGINS=

# ============ RATE LIMIT ============
RATE_WINDOW=60
RATE_MAX=60

# ============ SUPABASE (opsional, untuk persistensi) ============
SUPABASE_URL=
SUPABASE_KEY=
# Service key bypass RLS — gunakan dengan hati-hati, jangan diekspos ke client.
SUPABASE_SERVICE_KEY=

# ============ FRONTEND ============
# Path index.html. Default: relatif ke direktori main.py.
# FRONTEND_FILE=