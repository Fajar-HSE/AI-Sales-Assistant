# ============ GATEWAY WHATSAPP (Fonnte) ============
# Token dari dashboard fonnte.com
FONNTE_TOKEN=your_fonnte_token
FONNTE_FROM_NUMBER=6281227928537

# ============ LLM (Groq) ============
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ============ WEBHOOK SECURITY (WAJIB utk production) ============
# Tanpa ini, /webhook/fonnte MENOLAK semua request (secure by default).
# Kirim via header "x-webhook-token" ATAU tambahkan "?token=<isi>" pada URL webhook Fonnte.
WEBHOOK_SECRET=

# ============ AUTH API (/api/v1/*) — WAJIB ============
# Server menolak boot jika JWT_SECRET_KEY kosong dan SAI_ALLOW_DEV_MODE tidak di-set.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRATION=86400
API_TOKEN=
ADMIN_USER=admin
# WAJIB diisi agar admin pertama dibuat. Minimal 8 karakter. Tidak ada lagi default 'admin123'.
ADMIN_PASSWORD=

# Escape hatch KHUSUS development lokal tanpa auth (semua request = admin dev).
# JANGAN pernah di-set di production.
SAI_ALLOW_DEV_MODE=

# ============ CORS ============
# Daftar origin yang diizinkan (pisahkan dengan koma). Kosong => default localhost dev.
CORS_ORIGINS=

# ============ RATE LIMIT ============
RATE_WINDOW=60
RATE_MAX=60

# ============ DATABASE ============
# Default: <repo>/data/app.db
DB_PATH=

# ============ SUPABASE STORAGE (opsional) ============
SUPABASE_URL=
SUPABASE_KEY=
# Service key bypass RLS — gunakan dengan hati-hati, jangan diekspos ke client.
SUPABASE_SERVICE_KEY=

# ============ FRONTEND ============
# Path index.html. Default: relatif ke root repo.
# FRONTEND_FILE=
